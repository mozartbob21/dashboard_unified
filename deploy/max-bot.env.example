# Merge these settings into the server's existing .env; never commit the real token.
# Disabled by default. No worker starts automatically with the web application.
MAX_ZIP_BOT_ENABLED=false
MAX_ZIP_BOT_MODE=development-polling
MAX_ZIP_BOT_TOKEN=
# Optional existing bot username, without a URL:
MAX_ZIP_BOT_PUBLIC_NAME=
# Optional separate security DB path, relative to project root:
MAX_ZIP_BOT_DB=data/max_bot.sqlite
# Public Russian Trusted Root CA shipped with the project, scoped to MAX only.
# An empty value also uses this bundled certificate; it is not installed in the OS.
# Override with an approved PEM bundle if required. Relative paths use the project root.
# Certificate and hostname verification always stay enabled.
MAX_ZIP_BOT_CA_FILE=deploy/certs/russian-trusted-root-ca.pem

# Optional explicit exception for trusted internal HTTP origins (empty by default).
# Browser-to-Neurona HTTP is NOT encrypted. Use only within your protected LAN.
# Exact origin, no path: http://PRIVATE_IP:PORT. DNS/public addresses are rejected.
# Requires an internal/loopback ASGI client too; do not trust arbitrary proxy headers.
MAX_ZIP_BOT_HTTP_ORIGINS=
