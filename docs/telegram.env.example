# Добавьте значения в существующий .env сервера и перезапустите приложение.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Необязательно, если серверу нужен прокси:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# По умолчанию сессии: <проект>/.private/telegram
# NEURONA_TELEGRAM_DIR=/absolute/private/path/telegram

# Необязательно: постоянный Fernet-ключ вместо автоматически созданного session.key.
# TELEGRAM_SESSION_KEY=
