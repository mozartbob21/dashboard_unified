/* =========================================================
   NEURONA UI — unified style.css
   Для страниц: home / edo / overdue / watercontrol / utnkr /
   cameras / camera_prescriptions
   ========================================================= */

/* -------------------------
   THEME TOKENS
   ------------------------- */

:root {
    --bg: #f4f7fb;
    --bg-soft: #ffffff;
    --card: rgba(255, 255, 255, 0.86);
    --card-strong: rgba(255, 255, 255, 0.96);

    --text: #102033;
    --muted: #637083;
    --muted-2: #7e8ba0;

    --border: rgba(40, 65, 95, 0.14);
    --border-strong: rgba(40, 65, 95, 0.22);

    --primary: #3867ff;
    --primary-2: #6c4dff;
    --primary-3: #10b7ff;

    --danger: #ff3b5f;
    --danger-soft: rgba(255, 59, 95, 0.12);

    --ok: #16a36a;
    --ok-soft: rgba(22, 163, 106, 0.12);

    --risk: #f2a900;
    --risk-soft: rgba(242, 169, 0, 0.14);

    --info: #2563eb;
    --info-soft: rgba(37, 99, 235, 0.12);

    --violet: #7c3aed;
    --violet-soft: rgba(124, 58, 237, 0.13);

    --shadow: 0 24px 70px rgba(22, 31, 51, 0.12);
    --shadow-strong: 0 34px 110px rgba(22, 31, 51, 0.18);

    --radius: 28px;
    --radius-lg: 24px;
    --radius-md: 18px;
    --radius-sm: 14px;

    --transition: 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

html[data-theme="dark"] {
    --bg: #070b16;
    --bg-soft: #0d1324;
    --card: rgba(16, 24, 43, 0.78);
    --card-strong: rgba(17, 27, 49, 0.94);

    --text: #edf3ff;
    --muted: #9aa8bd;
    --muted-2: #7f8da3;

    --border: rgba(255, 255, 255, 0.11);
    --border-strong: rgba(255, 255, 255, 0.18);

    --primary: #6f8cff;
    --primary-2: #9b6dff;
    --primary-3: #2fd3ff;

    --danger: #ff5472;
    --danger-soft: rgba(255, 84, 114, 0.14);

    --ok: #31d084;
    --ok-soft: rgba(49, 208, 132, 0.13);

    --risk: #ffc04d;
    --risk-soft: rgba(255, 192, 77, 0.14);

    --info: #60a5fa;
    --info-soft: rgba(96, 165, 250, 0.13);

    --violet: #be96ff;
    --violet-soft: rgba(155, 109, 255, 0.15);

    --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    --shadow-strong: 0 42px 140px rgba(0, 0, 0, 0.46);
}

/* -------------------------
   RESET / BASE
   ------------------------- */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    scroll-behavior: smooth;
    color: var(--text);
    background:
        radial-gradient(circle at 10% 10%, rgba(76, 111, 255, 0.18), transparent 30%),
        radial-gradient(circle at 85% 15%, rgba(155, 109, 255, 0.17), transparent 28%),
        radial-gradient(circle at 50% 100%, rgba(47, 211, 255, 0.08), transparent 38%),
        linear-gradient(135deg, var(--bg), var(--bg-soft));
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}

body {
    position: relative;
    overflow-x: hidden;
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background: transparent;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -4;
    pointer-events: none;
    opacity: 0.42;
    background-image:
        linear-gradient(rgba(127, 143, 170, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(127, 143, 170, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 76%);
}

body.modal-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

::selection {
    color: #ffffff;
    background: rgba(111, 140, 255, 0.75);
}

/* -------------------------
   BACKGROUND GLOWS
   ------------------------- */

.page-glow {
    position: fixed;
    z-index: -3;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(18px);
    opacity: 0.8;
    transform: translate3d(0, 0, 0);
}

.page-glow-one {
    top: -160px;
    left: -110px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(56, 103, 255, 0.26), transparent 68%);
}

.page-glow-two {
    top: 30px;
    right: -150px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(155, 109, 255, 0.24), transparent 70%);
}

.page-glow-three {
    left: 35%;
    bottom: -260px;
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, rgba(47, 211, 255, 0.12), transparent 72%);
}

/* -------------------------
   LAYOUT
   ------------------------- */

.container {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 64px;
}

.grid.two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.section-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
}

.section-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-weight: 900;
}

/* -------------------------
   TOPBAR / BRAND
   ------------------------- */

.topbar {
    position: sticky;
    top: 14px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: 10px;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03)),
        var(--card);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 16px 44px rgba(15, 23, 42, 0.08);
}

.brand,
.brand-link {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-link {
    border-radius: 22px;
    padding: 6px 10px 6px 6px;
    color: inherit;
    transition: transform var(--transition), background var(--transition);
}

.brand-link:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.06);
}

.brand-logo {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    display: block;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow);
}

.brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.brand-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.08;
    font-weight: 850;
    letter-spacing: -0.035em;
}

.brand-subtitle {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
}

.topbar-right,
.top-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* -------------------------
   CARDS / HERO
   ------------------------- */

.card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
        var(--card);
    box-shadow: var(--shadow);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
}

.card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.16), transparent 34%),
        radial-gradient(circle at top right, rgba(111, 140, 255, 0.1), transparent 40%);
    opacity: 0.72;
}

.card > * {
    position: relative;
    z-index: 1;
}

.card:not(.hero):not(.action-card):not(.status-card):not(.loader-card) {
    padding: 28px;
    margin-bottom: 22px;
}

.hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.8fr);
    gap: 28px;
    padding: 38px;
    margin-bottom: 22px;
    min-height: 310px;
}

.hero::after {
    content: "";
    position: absolute;
    right: -120px;
    bottom: -150px;
    width: 390px;
    height: 390px;
    pointer-events: none;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(111, 140, 255, 0.22), transparent 68%);
}

.hero-copy {
    min-width: 0;
}

.hero-side {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-end;
    gap: 12px;
}

.hero-chip,
.tag {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 9px 13px;
    color: var(--muted);
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-size: 13px;
    font-weight: 750;
    transition: transform var(--transition), border-color var(--transition), color var(--transition);
}

.hero-chip:hover {
    transform: translateY(-2px);
    color: var(--text);
    border-color: var(--border-strong);
}

/* -------------------------
   TYPOGRAPHY
   ------------------------- */

h1,
h2,
h3 {
    margin: 0;
    letter-spacing: -0.055em;
}

h1 {
    max-width: 860px;
    margin-top: 14px;
    font-size: clamp(36px, 5vw, 66px);
    line-height: 0.94;
    font-weight: 950;
}

h2 {
    font-size: 25px;
    line-height: 1.15;
    font-weight: 900;
}

h3 {
    margin-top: 6px;
    font-size: 25px;
    line-height: 1.15;
    font-weight: 900;
}

.eyebrow,
.modal-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.eyebrow::before,
.modal-eyebrow::before {
    content: "";
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-3));
    box-shadow: 0 0 20px rgba(111, 140, 255, 0.8);
}

.subtext,
.lead,
.muted,
.info-text {
    color: var(--muted);
    line-height: 1.7;
}

.subtext {
    max-width: 760px;
    margin: 0;
    font-size: 15px;
}

.hero .subtext,
.hero .lead {
    margin-top: 20px;
    font-size: 16px;
}

.lead {
    max-width: 820px;
    margin: 0;
}

.big-time {
    margin: 0;
    font-size: 26px;
    font-weight: 950;
    letter-spacing: -0.045em;
}

/* -------------------------
   BUTTONS / LINKS
   ------------------------- */

.primary-button,
.secondary-button,
.action-btn,
.llm-btn,
.redmine-link-btn,
.module-link,
.theme-toggle,
.theme-toggle-btn,
.topbar-utnkr-btn,
.topbar-redmine-btn,
.version-label,
.version-button {
    appearance: none;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    border-radius: 999px;
    padding: 11px 17px;
    border: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    transition:
        transform var(--transition),
        box-shadow var(--transition),
        border-color var(--transition),
        background var(--transition),
        opacity var(--transition),
        color var(--transition);
}

.primary-button,
.module-link {
    overflow: hidden;
    color: #ffffff;
    border: none;
    background: linear-gradient(135deg, var(--primary), var(--primary-2));
    box-shadow:
        0 18px 44px rgba(64, 104, 255, 0.30),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.primary-button::before,
.module-link::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transform: translateX(-100%);
    transition: opacity var(--transition);
}

.primary-button:hover::before,
.module-link:hover::before {
    opacity: 1;
    animation: button-shine 900ms ease;
}

@keyframes button-shine {
    to {
        transform: translateX(100%);
    }
}

.secondary-button,
.theme-toggle,
.theme-toggle-btn,
.topbar-utnkr-btn,
.version-label,
.version-button {
    color: var(--text);
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
        var(--card);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.08);
}

.primary-button:hover:not(:disabled),
.secondary-button:hover:not(:disabled),
.module-link:hover,
.theme-toggle:hover,
.theme-toggle-btn:hover,
.topbar-utnkr-btn:hover,
.version-button:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
}

.primary-button:disabled,
.secondary-button:disabled,
.module-link-disabled,
.module-link-disabled:hover {
    cursor: not-allowed;
    opacity: 0.62;
    transform: none;
    box-shadow: none;
}

.topbar-redmine-btn {
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    box-shadow: 0 12px 30px rgba(220, 38, 38, 0.26);
}

.topbar-redmine-btn:hover {
    color: #ffffff;
    transform: translateY(-2px);
    background: linear-gradient(135deg, #f97316 0%, #dc2626 100%);
    box-shadow: 0 16px 34px rgba(220, 38, 38, 0.34);
}

.violator-link-utnkr {
    color: var(--violet);
    background: var(--violet-soft);
    border-color: rgba(124, 58, 237, 0.28);
}

.external-link-icon {
    color: currentColor;
    font-size: 13px;
    transform: translateY(-1px);
}

.action-panel,
.message-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.action-panel {
    justify-content: flex-end;
}

.message-actions {
    margin-top: 14px;
}

.action-btn {
    min-height: 40px;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13px;
}

.action-btn-warning {
    color: var(--risk);
    background: var(--risk-soft);
    border-color: rgba(242, 169, 0, 0.28);
}

.action-btn-success {
    color: var(--ok);
    background: var(--ok-soft);
    border-color: rgba(22, 163, 106, 0.28);
}

.redmine-link-btn {
    min-height: 38px;
    border-radius: 14px;
    color: var(--primary);
    background: var(--info-soft);
    border-color: rgba(96, 165, 250, 0.22);
}

/* -------------------------
   BADGES / PILLS
   ------------------------- */

.badge,
.pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    border-radius: 999px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: -0.01em;
    white-space: nowrap;
    border: 1px solid transparent;
}

.badge {
    min-height: 36px;
    padding: 8px 14px;
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.20);
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.pill::before {
    content: "";
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: currentColor;
}

.pill.primary,
.pill-edited {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.22);
}

.pill-critical,
.pill-red {
    color: var(--danger);
    background: var(--danger-soft);
    border-color: rgba(255, 84, 114, 0.28);
}

.pill-risk,
.pill-yellow,
.pill-warning {
    color: var(--risk);
    background: var(--risk-soft);
    border-color: rgba(255, 192, 77, 0.28);
}

.pill-ok,
.pill-green {
    color: var(--ok);
    background: var(--ok-soft);
    border-color: rgba(49, 208, 132, 0.28);
}

.pill-blue {
    color: var(--info);
    background: var(--info-soft);
    border-color: rgba(96, 165, 250, 0.28);
}

.pill-violet {
    color: var(--violet);
    background: var(--violet-soft);
    border-color: rgba(155, 109, 255, 0.28);
}

.pill-white,
.pill-outline {
    color: var(--muted);
    background: rgba(154, 168, 189, 0.12);
    border-color: rgba(154, 168, 189, 0.24);
}

.pill.soon {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.13);
    border-color: rgba(245, 158, 11, 0.28);
}

/* -------------------------
   METRICS
   ------------------------- */

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}

.metric-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 23px;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
        var(--card);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.metric-card::after {
    content: "";
    position: absolute;
    right: -42px;
    top: -42px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(111, 140, 255, 0.15), transparent 68%);
    pointer-events: none;
}

.metric-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-strong);
}

.metric-card.critical {
    background:
        radial-gradient(circle at 85% 10%, rgba(255, 84, 114, 0.18), transparent 36%),
        linear-gradient(135deg, var(--danger-soft), var(--card));
}

.metric-card.ok {
    background:
        radial-gradient(circle at 85% 10%, rgba(49, 208, 132, 0.16), transparent 36%),
        linear-gradient(135deg, var(--ok-soft), var(--card));
}

.metric-card.risk {
    background:
        radial-gradient(circle at 85% 10%, rgba(255, 192, 77, 0.18), transparent 36%),
        linear-gradient(135deg, var(--risk-soft), var(--card));
}

.metric-label {
    position: relative;
    z-index: 1;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
}

.metric-value {
    position: relative;
    z-index: 1;
    margin-top: 10px;
    font-size: 42px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: -0.065em;
}

.metric-value-text {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.035em;
}

/* -------------------------
   ACTION / STATUS / LOADER
   ------------------------- */

.action-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 28px;
    margin-bottom: 22px;
}

.action-card h2,
.status-card h2,
.loader-card h2 {
    margin-bottom: 8px;
}

.action-card .subtext {
    margin-bottom: 0;
}

.status-card {
    padding: 26px;
    margin-bottom: 22px;
}

.system-status {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr;
    gap: 22px;
    align-items: center;
}

.status-title,
.stage-label {
    color: var(--muted);
    font-size: 13px;
    font-weight: 750;
}

.system-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    border-radius: 999px;
    padding: 10px 14px;
    font-weight: 850;
}

.system-badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 18px currentColor;
}

.system-badge.ready {
    color: var(--ok);
    background: var(--ok-soft);
}

.system-badge.running {
    color: var(--risk);
    background: var(--risk-soft);
}

.stage-value {
    font-size: 23px;
    font-weight: 950;
    letter-spacing: -0.045em;
}

.stage-message {
    margin-top: 9px;
    color: var(--muted);
    line-height: 1.55;
}

.loader-card {
    padding: 26px;
    margin-bottom: 22px;
    border-color: rgba(111, 140, 255, 0.26);
}

.loader-wrap {
    display: flex;
    gap: 18px;
    align-items: center;
}

.spinner {
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    border: 4px solid var(--border);
    border-top-color: var(--primary);
    border-right-color: var(--primary-2);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    box-shadow: 0 0 32px rgba(111, 140, 255, 0.22);
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.hidden {
    display: none !important;
}

.status-message {
    position: relative;
    overflow: hidden;
    margin-bottom: 22px;
    border: 1px solid rgba(255, 84, 114, 0.35);
    border-radius: 20px;
    padding: 16px 18px;
    color: var(--danger);
    background:
        linear-gradient(135deg, var(--danger-soft), rgba(255, 255, 255, 0.03));
    box-shadow: 0 16px 46px rgba(255, 84, 114, 0.08);
    font-weight: 800;
}

.status-message.success {
    color: var(--ok);
    background: linear-gradient(135deg, var(--ok-soft), rgba(255, 255, 255, 0.03));
    border-color: rgba(49, 208, 132, 0.30);
}

.status-message.error {
    color: var(--danger);
    background: linear-gradient(135deg, var(--danger-soft), rgba(255, 255, 255, 0.03));
    border-color: rgba(255, 84, 114, 0.35);
}

/* -------------------------
   PRE / MESSAGES
   ------------------------- */

pre {
    overflow-x: auto;
    margin: 14px 0 0;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 15px;
    color: var(--text);
    background: rgba(0, 0, 0, 0.08);
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.55;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 13px;
}

html[data-theme="light"] pre {
    background: rgba(16, 32, 51, 0.045);
}

.message-block {
    position: relative;
    overflow: hidden;
    margin-top: 16px;
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 19px;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    transition: transform var(--transition), border-color var(--transition), background var(--transition);
}

.message-block:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
}

.message-block::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -90px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 84, 114, 0.10), transparent 68%);
    pointer-events: none;
}

.message-block.empty-state::after {
    background: radial-gradient(circle, rgba(255, 192, 77, 0.12), transparent 68%);
}

.message-block > * {
    position: relative;
    z-index: 1;
}

.message-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.message-head-badges {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 10px;
}

.message-head-badges strong {
    display: block;
    line-height: 1.45;
    font-weight: 850;
    letter-spacing: -0.025em;
}

.message-meta {
    display: grid;
    gap: 4px;
    margin-top: 10px;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
}

.message-link-row {
    margin: 12px 0;
}

/* Цветные message-block для УТНКР */
.message-block-red,
.message-block-yellow,
.message-block-green,
.message-block-blue,
.message-block-violet,
.message-block-white {
    border-left-width: 4px;
    border-left-style: solid;
}

.message-block-red {
    border-left-color: var(--danger);
}

.message-block-yellow {
    border-left-color: var(--risk);
}

.message-block-green {
    border-left-color: var(--ok);
}

.message-block-blue {
    border-left-color: var(--info);
}

.message-block-violet {
    border-left-color: var(--violet);
}

.message-block-white {
    border-left-color: var(--muted);
}

/* -------------------------
   COLLAPSE
   ------------------------- */

.collapse-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 14px 0;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
}

.collapse-toggle h2 {
    margin: 0;
}

.collapse-icon {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
    transition: transform var(--transition);
}

.collapse-toggle.expanded .collapse-icon {
    transform: rotate(180deg);
}

.collapsible-content.hidden-block {
    display: none;
}

/* -------------------------
   TABLES
   ------------------------- */

.table-wrap {
    overflow-x: auto;
    margin-top: 16px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.025);
}

table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
}

th,
td {
    border-bottom: 1px solid var(--border);
    padding: 15px 14px;
    text-align: left;
    vertical-align: top;
}

tr:last-child td {
    border-bottom: none;
}

th {
    color: var(--muted);
    font-size: 13px;
    font-weight: 850;
    background: rgba(255, 255, 255, 0.04);
}

td {
    line-height: 1.55;
    word-break: break-word;
}

tbody tr {
    transition: background var(--transition);
}

tbody tr:hover {
    background: rgba(111, 140, 255, 0.05);
}

.status-critical td,
tr.status-critical {
    background: rgba(255, 84, 114, 0.045);
}

.status-risk td,
tr.status-risk {
    background: rgba(255, 192, 77, 0.055);
}

.status-ok td,
tr.status-ok {
    background: rgba(49, 208, 132, 0.045);
}

.status-red td,
tr.status-red {
    background: rgba(255, 84, 114, 0.045);
}

.status-yellow td,
tr.status-yellow {
    background: rgba(255, 192, 77, 0.055);
}

.status-green td,
tr.status-green {
    background: rgba(49, 208, 132, 0.045);
}

.status-blue td,
tr.status-blue {
    background: rgba(47, 211, 255, 0.05);
}

.status-violet td,
tr.status-violet {
    background: rgba(155, 109, 255, 0.05);
}

.status-white td,
tr.status-white {
    background: rgba(154, 168, 189, 0.045);
}

.table-link {
    color: var(--primary);
    font-weight: 850;
}

/* УТНКР таблица */
.utnkr-table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    border-radius: 22px;
}

.utnkr-detail-table {
    width: 100%;
    min-width: 1480px;
    table-layout: fixed;
    border-collapse: collapse;
}

.utnkr-detail-table th,
.utnkr-detail-table td {
    vertical-align: top;
    word-break: normal;
    overflow-wrap: break-word;
    white-space: normal;
}

.utnkr-detail-table th {
    white-space: nowrap;
}

.utnkr-col-number {
    width: 52px;
}

.utnkr-col-municipality {
    width: 170px;
}

.utnkr-col-object {
    width: 430px;
}

.utnkr-col-organization {
    width: 280px;
}

.utnkr-col-responsible {
    width: 180px;
}

.utnkr-col-status {
    width: 130px;
}

.utnkr-col-overdue {
    width: 300px;
}

.utnkr-detail-table td:first-child,
.utnkr-detail-table th:first-child {
    white-space: nowrap;
}

.utnkr-detail-table td:nth-child(6),
.utnkr-detail-table th:nth-child(6) {
    text-align: center;
}

/* -------------------------
   FILTERS / FORMS
   ------------------------- */

.details-toolbar,
.prescriptions-filter-form,
.git-token-row,
.upload-form {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

select,
input[type="text"],
input[type="password"],
input[type="file"],
textarea {
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 10px 14px;
    color: var(--text);
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
        var(--card);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
}

select:focus,
input:focus,
textarea:focus {
    border-color: rgba(111, 140, 255, 0.55);
    box-shadow: 0 0 0 4px rgba(111, 140, 255, 0.14);
}

.git-token-input {
    min-width: 220px;
}

/* УТНКР фильтры */
.utnkr-filters-card {
    margin-bottom: 22px;
}

.utnkr-filters-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.utnkr-filters-title-wrap h2 {
    margin-bottom: 6px;
}

.utnkr-filter-count {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 850;
    color: var(--info);
    background: var(--info-soft);
    border: 1px solid rgba(96, 165, 250, 0.28);
    white-space: nowrap;
}

.utnkr-filters-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(220px, 1fr)) auto;
    gap: 14px;
    align-items: end;
}

.utnkr-filter-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.utnkr-filter-field label {
    font-size: 13px;
    font-weight: 750;
    color: var(--muted);
}

.utnkr-filter-field select {
    width: 100%;
}

.utnkr-reset-filters-btn {
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 16px;
    border: 1px solid rgba(255, 84, 114, 0.35);
    background: var(--danger-soft);
    color: var(--danger);
    font-weight: 850;
    cursor: pointer;
}

.utnkr-no-filter-results {
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--risk-soft);
    border: 1px solid rgba(255, 192, 77, 0.25);
    color: var(--risk);
    font-weight: 750;
}

/* -------------------------
   LISTS / CHIPS
   ------------------------- */

.missing-fields-list {
    margin: 8px 0 0 0;
    padding-left: 18px;
}

.missing-fields-list li {
    margin-bottom: 4px;
}

.inline-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.field-chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 11px;
    border-radius: 999px;
    color: var(--risk);
    background: var(--risk-soft);
    border: 1px solid rgba(255, 192, 77, 0.30);
    font-size: 13px;
    font-weight: 750;
    line-height: 1.2;
}

/* -------------------------
   SCREENSHOTS
   ------------------------- */

.screenshots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 16px;
}

.screenshot-card {
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    padding: 14px;
}

.screenshot-card-title {
    font-size: 14px;
    font-weight: 850;
    margin-bottom: 10px;
}

.screenshot-gallery-image {
    display: block;
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--border);
}

/* -------------------------
   MODALS
   ------------------------- */

.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background:
        radial-gradient(circle at 50% 30%, rgba(111, 140, 255, 0.15), transparent 30%),
        rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
}

.modal-card {
    width: min(720px, 100%);
    max-height: min(760px, calc(100vh - 40px));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 30px;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
        var(--card-strong);
    box-shadow: var(--shadow-strong);
    animation: modal-in 180ms ease;
}

.modal-card-wide {
    width: min(920px, 100%);
}

@keyframes modal-in {
    from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.modal-header,
.modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 22px;
}

.modal-header {
    border-bottom: 1px solid var(--border);
}

.modal-footer {
    border-top: 1px solid var(--border);
}

.modal-body {
    max-height: 480px;
    overflow-y: auto;
    padding: 22px;
}

.modal-close-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text);
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    cursor: pointer;
    transition: transform var(--transition), background var(--transition), border-color var(--transition);
}

.modal-close-btn:hover {
    transform: rotate(90deg) scale(1.04);
    border-color: var(--border-strong);
}

.modal-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.llm-btn {
    min-height: 40px;
    border-radius: 14px;
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.22);
}

.llm-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

.llm-hint,
.modal-label {
    font-size: 13px;
    color: var(--muted);
}

.modal-label {
    display: block;
    margin-bottom: 8px;
}

.modal-textarea {
    width: 100%;
    min-height: 260px;
    resize: vertical;
    line-height: 1.6;
}

/* -------------------------
   HOME PAGE
   ------------------------- */

.modules-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 22px;
}

.module-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

.module-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.module-title {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 950;
}

.module-description {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 16px;
}

.tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    margin-bottom: 18px;
}

.soft-card {
    width: 100%;
    background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 16px 18px;
}

.soft-card-title {
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 8px;
}

.soft-card-text {
    font-size: 15px;
    line-height: 1.6;
    font-weight: 750;
    color: var(--text);
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 18px;
}

.module-card-disabled {
    position: relative;
    opacity: 0.78;
    overflow: hidden;
}

.module-card-disabled::after {
    content: "СКОРО";
    position: absolute;
    top: 18px;
    right: -38px;
    width: 150px;
    padding: 7px 0;
    text-align: center;
    transform: rotate(35deg);
    background: linear-gradient(135deg, #f59e0b 0%, #fb7185 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    box-shadow: 0 12px 24px rgba(245, 158, 11, 0.24);
}

/* -------------------------
   GIT UPDATE CARD
   ------------------------- */

.git-update-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
}

.update-status-card {
    position: relative;
    overflow: hidden;
    margin-top: 18px;
    padding: 20px 22px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    border: 1px solid rgba(99, 102, 241, 0.18);
    background:
        radial-gradient(circle at 0% 0%, rgba(99, 102, 241, 0.12), transparent 34%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.03));
    box-shadow: 0 16px 44px rgba(15, 23, 42, 0.08);
}

.update-status-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: linear-gradient(180deg, var(--primary), var(--primary-2));
}

.update-status-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 25px;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #64748b, #475569);
    box-shadow:
        0 14px 28px rgba(15, 23, 42, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

.update-status-content {
    min-width: 0;
}

.update-status-title {
    color: var(--text);
    font-size: 19px;
    font-weight: 850;
    line-height: 1.25;
}

.update-status-text {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
}

.update-status-success .update-status-icon {
    background: linear-gradient(135deg, #22c55e, #16a34a);
}

.update-status-update .update-status-icon,
.update-status-process .update-status-icon {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.update-status-warning .update-status-icon {
    background: linear-gradient(135deg, #f59e0b, #d97706);
}

.update-status-error .update-status-icon {
    background: linear-gradient(135deg, #ef4444, #dc2626);
}

/* -------------------------
   WHAT'S NEW MODAL
   ------------------------- */

.whats-new-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.whats-new-modal.is-open {
    display: flex;
}

.whats-new-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.46);
    backdrop-filter: blur(18px);
}

.whats-new-dialog {
    position: relative;
    width: min(760px, 100%);
    max-height: min(86vh, 820px);
    overflow: auto;
    border-radius: 34px;
    padding: 38px;
    background:
        radial-gradient(circle at top left, rgba(99, 102, 241, 0.16), transparent 34%),
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 36%),
        var(--card-strong);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-strong);
    color: var(--text);
    animation: modal-in 0.22s ease-out;
}

.whats-new-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: rgba(148, 163, 184, 0.18);
    color: var(--text);
    font-size: 26px;
    line-height: 1;
}

.whats-new-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.12);
    color: var(--primary);
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.whats-new-title {
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 0.96;
    font-weight: 950;
}

.whats-new-lead {
    margin: 18px 0 26px;
    max-width: 650px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.58;
}

.whats-new-list {
    display: grid;
    gap: 14px;
}

.whats-new-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 18px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
}

.whats-new-icon {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #5b5cf6, #7c3aed);
    color: #ffffff;
    font-size: 22px;
    font-weight: 900;
    box-shadow: 0 12px 28px rgba(91, 92, 246, 0.28);
}

.whats-new-item h3 {
    margin: 0 0 6px;
    font-size: 18px;
}

.whats-new-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
}

.whats-new-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 22px;
}

/* -------------------------
   CAMERAS UPLOAD / GROUPS
   ------------------------- */

.premium-upload-card {
    border-color: rgba(111, 140, 255, 0.24);
}

.premium-upload-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
}

.premium-upload-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
}

.premium-upload-stat {
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.04);
}

.premium-upload-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 8px;
}

.premium-upload-value {
    font-size: 14px;
    font-weight: 800;
    word-break: break-word;
}

.mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.premium-preview-block {
    margin-top: 16px;
}

.premium-preview {
    max-height: 220px;
}

.upload-modal-note,
.upload-status-box {
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 14px 16px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    margin-bottom: 16px;
}

.group-block {
    margin-top: 18px;
}

.group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
}

.group-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 34px;
    border-radius: 999px;
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.22);
    font-weight: 850;
}

/* -------------------------
   VIOLATORS / UTNKR SECTION
   ------------------------- */

.violators-section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
}

.violators-section-title-wrap {
    min-width: 0;
    flex: 1;
}

.violators-collapse-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.06);
    color: inherit;
    cursor: pointer;
    transition: all var(--transition);
    font: inherit;
    white-space: nowrap;
}

.violators-collapse-btn:hover {
    background: rgba(255, 255, 255, 0.10);
    transform: translateY(-1px);
}

.violators-collapse-btn-icon {
    font-weight: 800;
    line-height: 1;
}

.violators-section-body {
    margin-top: 18px;
}

.violators-section.is-collapsed .violators-section-body {
    display: none;
}

/* -------------------------
   PRESCRIPTIONS PAGE
   ------------------------- */

.prescriptions-container {
    width: min(1240px, calc(100% - 32px));
}

.prescriptions-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.6fr);
    gap: 28px;
    padding: 38px;
    margin-bottom: 22px;
}

.prescriptions-hero h1 {
    font-size: clamp(34px, 4vw, 56px);
}

.prescriptions-hero-side {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-end;
    gap: 12px;
}

.prescriptions-summary {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.prescriptions-summary-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
}

.summary-label {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
}

.prescriptions-action-card,
.prescriptions-download-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
}

.prescriptions-select {
    min-width: 260px;
}

.muted-text {
    color: var(--muted);
}

/* -------------------------
   RESPONSIVE
   ------------------------- */

@media (max-width: 1100px) {
    .modules-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .premium-upload-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {
    .topbar,
    .action-card,
    .system-status,
    .prescriptions-action-card,
    .prescriptions-download-card {
        align-items: stretch;
        flex-direction: column;
    }

    .topbar {
        position: static;
    }

    .topbar-right,
    .top-actions {
        width: 100%;
    }

    .hero,
    .prescriptions-hero {
        grid-template-columns: 1fr;
    }

    .hero-side,
    .prescriptions-hero-side {
        justify-content: flex-start;
    }

    .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .system-status,
    .grid.two {
        display: grid;
        grid-template-columns: 1fr;
    }

    .utnkr-filters-grid {
        grid-template-columns: 1fr;
    }

    .utnkr-reset-filters-btn {
        width: 100%;
    }

    .info-grid,
    .modules-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .container,
    .prescriptions-container {
        width: min(100% - 20px, 1180px);
        padding-top: 14px;
    }

    .topbar {
        padding: 8px;
        border-radius: 22px;
    }

    .brand-link {
        align-items: flex-start;
        gap: 10px;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 16px;
    }

    .brand-title {
        font-size: 15px;
    }

    .brand-subtitle {
        font-size: 12px;
    }

    .topbar-right,
    .top-actions {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
    }

    .theme-toggle,
    .theme-toggle-btn,
    .topbar-utnkr-btn,
    .topbar-redmine-btn,
    .version-label,
    .primary-button,
    .secondary-button,
    .module-link {
        width: 100%;
    }

    .metrics-grid,
    .premium-upload-grid {
        grid-template-columns: 1fr;
    }

    .hero,
    .prescriptions-hero,
    .card:not(.hero):not(.action-card):not(.status-card):not(.loader-card),
    .action-card,
    .status-card,
    .loader-card {
        padding: 20px;
    }

    h1 {
        font-size: clamp(34px, 12vw, 48px);
    }

    h2,
    .section-title {
        font-size: 23px;
    }

    .action-panel,
    .message-actions,
    .details-toolbar,
    .prescriptions-filter-form,
    .git-token-row,
    .upload-form {
        width: 100%;
        justify-content: stretch;
    }

    .loader-wrap {
        align-items: flex-start;
    }

    .spinner {
        width: 42px;
        height: 42px;
    }

    .modal-header,
    .modal-body,
    .modal-footer {
        padding: 16px;
    }

    .modal-footer {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .whats-new-dialog {
        padding: 30px 22px 24px;
        border-radius: 28px;
    }

    .whats-new-item {
        grid-template-columns: 1fr;
    }

    .whats-new-icon {
        width: 44px;
        height: 44px;
    }

    .violators-section-header {
        flex-direction: column;
        align-items: stretch;
    }

    .violators-collapse-btn {
        width: 100%;
        justify-content: center;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
    }
}
/* =========================================================
   COMPACT HERO FOR EDO / OVERDUE / WATERCONTROL
   ========================================================= */

.compact-module-page .topbar {
    min-height: 74px;
}

.compact-module-page .hero {
    grid-template-columns: minmax(0, 1.85fr) minmax(230px, 0.55fr);
    min-height: 430px;
    padding: 34px 38px;
}

.compact-module-page .hero h1 {
    max-width: 760px;
    font-size: clamp(38px, 4.15vw, 58px);
    line-height: 0.98;
    letter-spacing: -0.06em;
}

.compact-module-page .hero .subtext {
    max-width: 760px;
    margin-top: 18px;
}

.compact-module-page .hero-side {
    justify-content: center;
    align-content: center;
}

.compact-module-page .hero-chip {
    padding: 9px 13px;
    font-size: 13px;
}

/* Ещё компактнее на средних экранах */
@media (max-width: 1180px) {
    .compact-module-page .hero h1 {
        font-size: clamp(36px, 4vw, 52px);
    }

    .compact-module-page .hero {
        min-height: 390px;
    }
}

/* На планшетах hero становится в одну колонку */
@media (max-width: 900px) {
    .compact-module-page .hero {
        grid-template-columns: 1fr;
        min-height: auto;
    }

    .compact-module-page .hero h1 {
        max-width: 100%;
        font-size: clamp(34px, 7vw, 48px);
    }

    .compact-module-page .hero-side {
        justify-content: flex-start;
    }
}

/* На мобильных не делаем заголовок огромным */
@media (max-width: 640px) {
    .compact-module-page .topbar {
        min-height: auto;
    }

    .compact-module-page .hero {
        padding: 22px;
    }

    .compact-module-page .hero h1 {
        font-size: clamp(32px, 10vw, 42px);
        line-height: 1;
    }
}